# Port the server listens on (Render sets this automatically)
PORT=3002

# Scalekit environment URL (e.g. https://your-env.scalekit.com)
SCALEKIT_ENVIRONMENT_URL=https://your-env.scalekit.com

# Scalekit client credentials — from the API Credentials page in the dashboard
SCALEKIT_CLIENT_ID=your_client_id
SCALEKIT_CLIENT_SECRET=your_client_secret

# SCALEKIT_RESOURCE_ID is NOT needed here — it is passed to /configure on every
# test run because the test creates a fresh MCP server each time.

# Public base URL for this server (trailing slash).
# Used by ScalekitProvider to build the /mcp endpoint URL.
# Locally: http://localhost:3002/  |  Render: https://<your-service>.onrender.com/
MCP_BASE_URL=http://localhost:3002/

# Secret used to protect the /configure endpoint.
# The test sends this in the X-Configure-Secret header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CONFIGURE_SECRET=change-me-generate-a-random-secret
